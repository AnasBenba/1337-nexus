# 1337 Nexus Environment Configuration Example

POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME@postgres:5432/nexus
MIGRATION_DATABASE_URL=postgresql://nexus:CHANGE_ME@postgres:5432/nexus

TRUSTED_PROXY_SUBNET=172.20.0.0/16

PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine

TLS_CERT_PEM=
TLS_KEY_PEM=

# -----------------------------------------------------------------------------
# AI / Copilot / Google Gemini
# -----------------------------------------------------------------------------
# AI_PROVIDER: "stub" for local offline testing, "remote" for live embeddings
AI_PROVIDER=stub

# Google Gemini API Key
GEMINI_API_KEY=

# Embedding Configuration (1536-dim to match Vector(1536) schema)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
