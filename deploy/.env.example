POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql+asyncpg://nexus_app:nexus_app_password@postgres:5432/nexus

MIGRATION_DATABASE_URL=postgresql+asyncpg://nexus_migrator:nexus_migrator_password@postgres:5432/nexus

NGINX_PORT=8443

TLS_CERT_PEM=
TLS_KEY_PEM=

# "stub" for local offline mock testing, "remote" for live Google Gemini API
AI_PROVIDER=stub
# Google Gemini API Key (only required if AI_PROVIDER=remote)
GEMINI_API_KEY=

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

UID=your_42_intra_app_uid
SECRET=your_42_intra_app_secret
AUTH_URL=https://api.intra.42.fr/oauth/authorize?
REDIRECT_URL=https://localhost:8443/api/v1/auth/oauth/42/callback
FRONTEND_URL=https://localhost:8443/
# Random 32+ character string used for signing JWT cookies
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# -----------------------------------------------------------------------------
# 5. SuperAdmin Account (Created automatically on backend container startup)
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD_MIN_8_CHARS
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_NAME=Super Admin
# -----------------------------------------------------------------------------
# 6. Monitoring & Observability (Prometheus & Grafana)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD