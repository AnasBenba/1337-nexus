# 1337 Nexus Environment Configuration Example

POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME@postgres:5432/nexus
MIGRATION_DATABASE_URL=postgresql://nexus:CHANGE_ME@postgres:5432/nexus

TRUSTED_PROXY_SUBNET=172.20.0.0/16

PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine

TLS_CERT_PEM=
TLS_KEY_PEM=

# -----------------------------------------------------------------------------
# AI / Copilot / Google Gemini
# -----------------------------------------------------------------------------
# AI_PROVIDER: "stub" for local offline testing, "remote" for live embeddings
AI_PROVIDER=stub

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Configuration (1536-dim to match Vector(1536) schema)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Auth: 42 Intra OAuth + JWT
# -----------------------------------------------------------------------------
# Create an app at https://profile.intra.42.fr/oauth/applications and set its
# redirect URI to exactly REDIRECT_URL.
UID=your_42_app_uid
SECRET=your_42_app_secret
AUTH_URL=https://api.intra.42.fr/oauth/authorize?scope=public
REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/42/callback
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME

# Where the backend sends you after login
FRONTEND_URL=https://localhost:8443/

# 42 logins that become admin when they sign in (comma-separated)
ADMIN_LOGINS=
